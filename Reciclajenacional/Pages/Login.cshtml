@page
@model ReciclajeNacional.Pages.LoginModel

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>Iniciar sesión</title>

    <style>

            /* General */

            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                background-color: #111111;
                color: white;
            }

            /* Contenedor */

            .contenedor {
                width: 450px;
                margin: 60px auto;
                padding: 35px;
                background-color: #1f1f1f;
                border-radius: 10px;
                box-shadow: 0 0 15px rgba(0,0,0,0.5);
            }

            h1 {
                text-align: center;
                margin-bottom: 10px;
            }

            .subtitulo {
                text-align: center;
                color: #cccccc;
                margin-bottom: 30px;
            }

            /* Campos */

            .campo {
                margin-bottom: 20px;
            }

                .campo label {
                    display: block;
                    margin-bottom: 7px;
                    font-weight: bold;
                }

                .campo input {
                    width: 100%;
                    padding: 12px;
                    box-sizing: border-box;
                    border-radius: 5px;
                    border: 1px solid #555;
                    background-color: #333;
                    color: white;
                }

            /* Boton */

            .boton {
                width: 100%;
                padding: 12px;
                border: none;
                border-radius: 5px;
                background-color: #087fdb;
                color: white;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
            }

                .boton:hover {
                    background-color: #066bb8;
                }

            /* Registro */

            .registro {
                text-align: center;
                margin-top: 20px;
            }

                .registro a {
                    color: #4da3ff;
                    text-decoration: none;
                    font-weight: bold;
                }

                    .registro a:hover {
                        text-decoration: underline;
                    }

            /* Error */

            .error {
                margin-bottom: 20px;
                padding: 10px;
                background-color: #5c1f1f;
                border-radius: 5px;
                color: #ffaaaa;
                text-align: center;
            }

    </style>

</head>

<body>

    <div class="contenedor">

        <h1>
            Reciclaje<br />Nacional
        </h1>

        <p class="subtitulo">
            Inicia sesión para continuar
        </p>

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="error">
                @Model.Mensaje
            </div>
        }

        <form method="post">

            <div class="campo">

                <label>Correo:</label>

                <input asp-for="Correo"
                       type="email"
                       placeholder="Ingrese su correo"
                       required />

            </div>

            <div class="campo">

                <label>Contraseña:</label>

                <input asp-for="Contrasena"
                       type="password"
                       placeholder="Ingrese su contraseña"
                       required />

            </div>

            <button type="submit"
                    class="boton">
                Iniciar sesión
            </button>

        </form>

        <div class="registro">

            <p>
                ¿No tienes una cuenta?
            </p>

            <a asp-page="/Usuarios">
                Registrarse
            </a>

        </div>

    </div>

</body>

</html>