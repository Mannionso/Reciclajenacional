<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Reciclaje Nacional
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

            body {
                margin: 0;
                background-color: #111111;
                color: white;
            }

            main {
                background-color: #111111;
                min-height: 75vh;
            }

            .navbar {
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 25px;
                background-color: #111111;
                border-bottom: 1px solid #222222;
            }

            .navbar-left {
                display: flex;
                align-items: center;
            }

            .logo {
                color: white;
                text-decoration: none;
                font-size: 20px;
                font-weight: bold;
                cursor: pointer;
            }

                .logo:hover {
                    color: #00ff88;
                }

            .perfil-link {
                text-decoration: none;
            }

            .icono-perfil {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                object-fit: cover;
                cursor: pointer;
            }

                .icono-perfil:hover {
                    transform: scale(1.05);
                }

            .menu {
                position: fixed;
                top: 0;
                left: -300px;
                width: 300px;
                height: 100vh;
                background-color: #1f1f1f;
                z-index: 2000;
                transition: left 0.3s ease;
                box-shadow: 5px 0 20px rgba(0, 0, 0, 0.5);
            }

            .menu-abierto {
                left: 0;
            }

            .menu h2 {
                padding: 45px 22px 25px;
                margin: 0;
                color: #00ff88;
                border-bottom: 1px solid #333333;
            }

            .menu a {
                display: block;
                padding: 18px 22px;
                color: white;
                text-decoration: none;
                border-bottom: 1px solid #333333;
                font-size: 16px;
            }

                .menu a:hover {
                    background-color: #292929;
                    color: #00ff88;
                }

            .cerrar-menu {
                position: absolute;
                right: 18px;
                top: 12px;
                border: none;
                background: none;
                color: white;
                font-size: 28px;
                cursor: pointer;
            }

                .cerrar-menu:hover {
                    color: #00ff88;
                }

            .fondo-menu {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background-color: rgba(0, 0, 0, 0.6);
                z-index: 1500;
            }

            .fondo-visible {
                display: block;
            }

            footer {
                padding: 20px;
                border-top: 1px solid #333333;
                text-align: center;
                color: #777777;
                background-color: #111111;
            }

                footer a {
                    color: #00aaff;
                }

    </style>

</head>

<body>

    @{
        bool paginaPublica =
            Context.Request.Path.StartsWithSegments("/Login") ||
            Context.Request.Path.StartsWithSegments("/RegistrarUsuario");
    }

    @if (!paginaPublica)
    {
        <header>

            <nav class="navbar">

                <div class="navbar-left">

                    <a class="logo"
                       onclick="abrirMenu()">

                        Reciclaje Nacional

                    </a>

                </div>

                <a asp-page="/MiPerfil"
                   class="perfil-link">

                    <img src="~/images/fotoperfil.jpg"
                         class="icono-perfil"
                         alt="Perfil" />

                </a>

            </nav>

        </header>

        <div id="menu"
             class="menu">

            <button class="cerrar-menu"
                    onclick="cerrarMenu()">

                ×

            </button>

            <h2>
                Reciclaje Nacional
            </h2>

            <a asp-page="/Index">
                Inicio
            </a>

            <a asp-page="/Centros">
                Centros de reciclaje
            </a>

            <a asp-page="/BuscarUsuario">
                Buscar usuario
            </a>

            <a asp-page="/Estadisticas">
                Mis reciclajes
            </a>

            <a asp-page="/Materiales">
                Materiales
            </a>

            <a asp-page="/Recompensas">
                Recompensas
            </a>

            <a asp-page="/Canjes">
                Mis canjes
            </a>

            <a asp-page="/Registroreciclaje">
                Registrar reciclaje
            </a>

        </div>

        <div id="fondoMenu"
             class="fondo-menu"
             onclick="cerrarMenu()">
        </div>
    }

    <main>

        @RenderBody()

    </main>

    @if (!paginaPublica)
    {
        <footer>

            <div>

                &copy; 2026 - Reciclaje Nacional -

                <a asp-page="/Privacy">
                    Privacy
                </a>

            </div>

        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @if (!paginaPublica)
    {
        <script>

            function abrirMenu() {

            document
            .getElementById("menu")
            .classList.add("menu-abierto");

            document
            .getElementById("fondoMenu")
            .classList.add("fondo-visible");

            }

            function cerrarMenu() {

            document
            .getElementById("menu")
            .classList.remove("menu-abierto");

            document
            .getElementById("fondoMenu")
            .classList.remove("fondo-visible");

            }

        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>