<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Reciclaje Nacional</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Reciclajenacional.styles.css"
          asp-append-version="true" />


    <style>

            /* ========================================= */
            /* PAGINA GENERAL */
            /* ========================================= */

            html,
            body {
                background-color: #111111 !important;
                color: white !important;
                margin: 0;
                padding: 0;
            }


            /* ========================================= */
            /* BARRA SUPERIOR */
            /* ========================================= */

            .navbar {
                background-color: #111111 !important;
                border-bottom: 1px solid #222222 !important;
                height: 55px;
            }


                .navbar .container {
                    max-width: 100%;
                    margin: 0;
                    padding-left: 25px;
                    padding-right: 25px;
                }


            /* ========================================= */
            /* NOMBRE DE LA APLICACION */
            /* ========================================= */

            .menu-logo {
                color: white !important;
                text-decoration: none !important;
                font-size: 20px;
                font-weight: bold;
                cursor: pointer;
                display: inline-block;
            }


                .menu-logo:hover {
                    color: #00ff88 !important;
                }


            /* ========================================= */
            /* OCULTAR LINKS NORMALES DE BOOTSTRAP */
            /* ========================================= */

            .navbar-nav {
                display: none !important;
            }


            /* ========================================= */
            /* BOTON DE PERFIL */
            /* ========================================= */

            .perfil-boton {
                position: fixed;
                top: 15px;
                right: 25px;
                width: 55px;
                height: 55px;
                border-radius: 50% !important;
                overflow: hidden;
                cursor: pointer;
                z-index: 1000;
                display: block;
                padding: 0;
                margin: 0;
                border: none;
                background: transparent;
            }


                .perfil-boton img {
                    width: 100%;
                    height: 100%;
                    display: block;
                    object-fit: cover;
                    border-radius: 50% !important;
                }


            /* ========================================= */
            /* MENU LATERAL */
            /* ========================================= */

            .menu-lateral {
                position: fixed;
                top: 0;
                left: -300px;
                width: 300px;
                height: 100vh;
                background-color: #1b1b1b;
                box-shadow: 5px 0 20px rgba(0, 0, 0, 0.5);
                z-index: 2000;
                transition: left 0.3s ease;
                padding-top: 70px;
            }


                .menu-lateral.abierto {
                    left: 0;
                }


                /* ========================================= */
                /* OPCIONES DEL MENU */
                /* ========================================= */

                .menu-lateral a {
                    display: block;
                    padding: 18px 25px;
                    color: white;
                    text-decoration: none;
                    font-size: 17px;
                    border-bottom: 1px solid #292929;
                }


                    .menu-lateral a:hover {
                        background-color: #252525;
                        color: #00ff88;
                    }


            /* ========================================= */
            /* TITULO DEL MENU */
            /* ========================================= */

            .menu-titulo {
                color: #00ff88;
                font-size: 22px;
                font-weight: bold;
                padding: 20px 25px;
                border-bottom: 1px solid #333333;
            }


            /* ========================================= */
            /* BOTON CERRAR */
            /* ========================================= */

            .cerrar-menu {
                position: absolute;
                top: 18px;
                right: 20px;
                color: white;
                font-size: 25px;
                cursor: pointer;
            }


                .cerrar-menu:hover {
                    color: #00ff88;
                }


            /* ========================================= */
            /* FONDO OSCURO DEL MENU */
            /* ========================================= */

            .fondo-menu {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                background-color: rgba(0, 0, 0, 0.6);
                z-index: 1500;
            }


                .fondo-menu.visible {
                    display: block;
                }


            /* ========================================= */
            /* CONTENIDO */
            /* ========================================= */

            main {
                background-color: #111111 !important;
            }


            /* ========================================= */
            /* FOOTER */
            /* ========================================= */

            footer {
                background-color: #111111 !important;
                color: #777777 !important;
                border-top: 1px solid #222222 !important;
            }


                footer a {
                    color: #00aaff !important;
                }

    </style>

</head>


<body>

    @{

        /*
            Páginas públicas.

            En Login y RegistrarUsuario NO queremos:

            - Menú lateral
            - Botón de perfil
            - Barra superior
        */

        bool paginaPublica =
            Context.Request.Path.StartsWithSegments("/Login") ||
            Context.Request.Path.StartsWithSegments("/RegistrarUsuario");

    }


    <!-- ===================================================== -->
    <!-- BARRA SUPERIOR -->
    <!-- ===================================================== -->
    @if (!paginaPublica)
    {
        <header>

            <nav class="navbar">

                <div class="container">

                    <!-- BOTON PARA ABRIR EL MENU -->

                    <a class="menu-logo"
                       onclick="abrirMenu()">

                        Reciclaje Nacional

                    </a>

                </div>

            </nav>

        </header>
    }


    <!-- ===================================================== -->
    <!-- MENU LATERAL -->
    <!-- ===================================================== -->
    @if (!paginaPublica)
    {

        <!-- FONDO OSCURO -->

        <div id="fondoMenu"
             class="fondo-menu"
             onclick="cerrarMenu()">
        </div>


        <!-- MENU LATERAL -->

        <div id="menuLateral"
             class="menu-lateral">


            <!-- BOTON CERRAR -->

            <span class="cerrar-menu"
                  onclick="cerrarMenu()">

                ×

            </span>


            <!-- TITULO -->

            <div class="menu-titulo">

                Reciclaje Nacional

            </div>


            <!-- INICIO -->

            <a asp-page="/Index">

                Inicio

            </a>


            <!-- CENTROS -->

            <a asp-page="/Centros">

                Centros de reciclaje

            </a>


            <!-- BUSCAR USUARIO -->

            <a asp-page="/Usuarios">

                Buscar usuario

            </a>


            <!-- MIS RECICLAJES -->

            <a asp-page="/Estadisticas">

                Mis reciclajes

            </a>


            <!-- MATERIALES -->

            <a asp-page="/Materiales">

                Materiales

            </a>


            <!-- RECOMPENSAS -->

            <a asp-page="/Recompensas">

                Recompensas

            </a>


            <!-- CANJES -->

            <a asp-page="/Canjes">

                Mis canjes

            </a>


            <!-- REGISTRAR RECICLAJE -->

            <a asp-page="/Registrarreciclaje">

                Registrar reciclaje

            </a>


        </div>

    }


    <!-- ===================================================== -->
    <!-- BOTON DE PERFIL -->
    <!-- ===================================================== -->
    @if (!paginaPublica)
    {

        <a asp-page="/MiPerfil"
           class="perfil-boton">

            <img src="~/images/fotoperfil.jpg"
                 alt="Perfil" />

        </a>

    }


    <!-- ===================================================== -->
    <!-- CONTENIDO DE LA PAGINA -->
    <!-- ===================================================== -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Reciclaje Nacional -

            <a asp-page="/Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- ===================================================== -->
    <!-- SCRIPTS -->
    <!-- ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @if (!paginaPublica)
    {

        <script>

            function abrirMenu() {

            document
            .getElementById("menuLateral")
            .classList.add("abierto");

            document
            .getElementById("fondoMenu")
            .classList.add("visible");

            }


            function cerrarMenu() {

            document
            .getElementById("menuLateral")
            .classList.remove("abierto");

            document
            .getElementById("fondoMenu")
            .classList.remove("visible");

            }

        </script>

    }


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>