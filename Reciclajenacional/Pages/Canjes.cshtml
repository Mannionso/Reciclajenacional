@page
@model ReciclajeNacional.Pages.CanjesModel

<h1>Canjes</h1>

<table border="1">
    <thead>
        <tr>
            <th>ID Canje</th>
            <th>ID Usuario</th>
            <th>ID Recompensa</th>
            <th>Fecha</th>
            <th>Puntos Utilizados</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var canje in Model.Canjes)
        {
            <tr>
                <td>@canje.IdCanje</td>
                <td>@canje.IdUsuario</td>
                <td>@canje.IdRecompensa</td>
                <td>@canje.Fecha</td>
                <td>@canje.PuntosUtilizados</td>
            </tr>
        }
    </tbody>
</table>