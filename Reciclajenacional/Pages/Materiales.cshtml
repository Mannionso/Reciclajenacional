@page
@model ReciclajeNacional.Pages.MaterialesModel

@{
    ViewData["Title"] = "Materiales Reciclables";
}

<style>
    .materiales-contenedor {
        max-width: 1000px;
        margin: 45px auto;
        padding: 0 25px;
    }

    .materiales-titulo {
        text-align: center;
        margin-bottom: 10px;
        font-size: 38px;
        font-weight: bold;
    }

    .materiales-subtitulo {
        text-align: center;
        color: #aaaaaa;
        margin-bottom: 35px;
        font-size: 16px;
    }

    .formulario-material {
        background-color: #1f1f1f;
        border: 1px solid #2d2d2d;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 35px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }

        .formulario-material h2 {
            margin-top: 0;
            margin-bottom: 25px;
            font-size: 24px;
        }

    .campo-material {
        margin-bottom: 20px;
    }

        .campo-material label {
            display: block;
            margin-bottom: 8px;
            color: #dddddd;
            font-weight: 500;
        }

        .campo-material input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 14px;
            border: 1px solid #444444;
            border-radius: 7px;
            background-color: #111111;
            color: white;
            font-size: 15px;
        }

            .campo-material input:focus {
                outline: none;
                border-color: #00c96b;
            }

    .boton-material {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 7px;
        background-color: #00b85c;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
    }

        .boton-material:hover {
            background-color: #00d66d;
        }

    .lista-materiales {
        background-color: #1f1f1f;
        border: 1px solid #2d2d2d;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }

        .lista-materiales h2 {
            margin-top: 0;
            margin-bottom: 25px;
            font-size: 24px;
        }

    .tabla-materiales {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: 8px;
    }

        .tabla-materiales th {
            background-color: #0d0d0d;
            color: #00d66d;
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #3a3a3a;
        }

        .tabla-materiales td {
            padding: 14px;
            border-bottom: 1px solid #333333;
            color: #dddddd;
        }

        .tabla-materiales tr:last-child td {
            border-bottom: none;
        }

        .tabla-materiales tr:hover {
            background-color: #252525;
        }

    .puntos {
        color: #00d66d !important;
        font-weight: bold;
    }

    @@media (max-width: 700px) {
        .materiales-contenedor {
            margin: 25px auto;
            padding: 0 15px;
        }

        .materiales-titulo {
            font-size: 30px;
        }

        .formulario-material,
        .lista-materiales {
            padding: 20px;
        }

        .tabla-materiales {
            font-size: 13px;
        }

            .tabla-materiales th,
            .tabla-materiales td {
                padding: 10px 7px;
            }
    }
</style>

<div class="materiales-contenedor">

    <h1 class="materiales-titulo">
        Materiales Reciclables
    </h1>

    <p class="materiales-subtitulo">
        Registra y consulta los materiales disponibles para reciclaje
    </p>

    <div class="formulario-material">

        <h2>Registrar material</h2>

        <form method="post">

            <div class="campo-material">
                <label>Nombre:</label>

                <input asp-for="Material.Nombre"
                       placeholder="Ejemplo: Plástico"
                       required />
            </div>

            <div class="campo-material">
                <label>Descripción:</label>

                <input asp-for="Material.Descripcion"
                       placeholder="Descripción del material"
                       required />
            </div>

            <div class="campo-material">
                <label>Puntos por Kg:</label>

                <input asp-for="Material.PuntosPorKg"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="Ejemplo: 10"
                       required />
            </div>

            <button type="submit"
                    class="boton-material">
                Registrar Material
            </button>

        </form>

    </div>

    <div class="lista-materiales">

        <h2>Materiales registrados</h2>

        <table class="tabla-materiales">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Puntos por Kg</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var material in Model.Materiales)
                {
                    <tr>
                        <td>@material.IdMaterial</td>
                        <td>@material.Nombre</td>
                        <td>@material.Descripcion</td>
                        <td class="puntos">
                            @material.PuntosPorKg
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>