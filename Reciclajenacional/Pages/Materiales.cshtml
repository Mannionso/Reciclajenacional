@page
@model ReciclajeNacional.Pages.MaterialesModel

<h1>Materiales Reciclables</h1>

<form method="post">

    <div>
        <label>Nombre:</label>
        <input asp-for="Material.Nombre" />
    </div>

    <br />

    <div>
        <label>Descripción:</label>
        <input asp-for="Material.Descripcion" />
    </div>

    <br />

    <div>
        <label>Puntos por Kg:</label>
        <input asp-for="Material.PuntosPorKg" type="number" step="0.01" />
    </div>

    <br />

    <button type="submit">Registrar Material</button>

</form>

<hr />

<h2>Materiales registrados</h2>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Puntos por Kg</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var material in Model.Materiales)
        {
            <tr>
                <td>@material.IdMaterial</td>
                <td>@material.Nombre</td>
                <td>@material.Descripcion</td>
                <td>@material.PuntosPorKg</td>
            </tr>
        }
    </tbody>
</table>