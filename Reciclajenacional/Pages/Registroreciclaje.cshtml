@page
@model ReciclajeNacional.Pages.RegistroreciclajeModel

@{
    ViewData["Title"] = "Registrar Reciclaje";
}

<h1>Registrar Reciclaje</h1>

<form method="post">

    <div>
        <label>Material:</label>

        <select asp-for="Registro.IdMaterial" required>
            <option value="">Seleccione un material</option>

            @foreach (var material in Model.Materiales)
            {
                <option value="@material.IdMaterial">
                    @material.Nombre - @material.PuntosPorKg puntos/Kg
                </option>
            }
        </select>

        <span asp-validation-for="Registro.IdMaterial"></span>
    </div>

    <br />

    <div>
        <label>Cantidad en Kg:</label>

        <input asp-for="Registro.CantidadKg"
               type="number"
               step="0.01"
               min="0.01"
               required />

        <span asp-validation-for="Registro.CantidadKg"></span>
    </div>

    <br />

    <button type="submit">
        Registrar Reciclaje
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}