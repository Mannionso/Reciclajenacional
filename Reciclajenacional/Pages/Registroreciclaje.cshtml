@page
@model ReciclajeNacional.Pages.RecompensasModel

@{
    ViewData["Title"] = "Recompensas";
}

<div class="contenedor-recompensas">

    <h1>Recompensas</h1>

    <p class="descripcion">
        Canjea tus puntos por diferentes recompensas.
    </p>

    <div class="puntos">
        <span>Mis puntos</span>
        <strong>@Model.PuntosUsuario</strong>
    </div>

    @if (TempData["MensajeCanje"] != null)
    {
        <div class="mensaje">
            @TempData["MensajeCanje"]
        </div>
    }

    <div class="recompensas">

        @foreach (var recompensa in Model.Recompensas)
        {
            <div class="tarjeta-recompensa">

                <h2>@recompensa.Nombre</h2>

                <p>
                    @recompensa.Descripcion
                </p>

                <div class="puntos-recompensa">
                    @recompensa.PuntosNecesarios puntos
                </div>

                <form method="post"
                      asp-page-handler="Canjear">

                    <input type="hidden"
                           name="idRecompensa"
                           value="@recompensa.IdRecompensa" />

                    <button type="submit"
                            class="boton-canjear">
                        Canjear
                    </button>

                </form>

            </div>
        }

    </div>

</div>

<style>

    .contenedor-recompensas {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
    }

        .contenedor-recompensas h1 {
            margin-bottom: 5px;
        }

    .descripcion {
        color: #aaa;
        margin-bottom: 25px;
    }

    .puntos {
        background: #1f1f1f;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .puntos strong {
            font-size: 24px;
        }

    .mensaje {
        background: #1f1f1f;
        border: 1px solid #00c853;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 25px;
    }

    .recompensas {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .tarjeta-recompensa {
        background: #1f1f1f;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 25px;
    }

        .tarjeta-recompensa h2 {
            margin-top: 0;
            margin-bottom: 12px;
        }

        .tarjeta-recompensa p {
            color: #aaa;
            min-height: 45px;
        }

    .puntos-recompensa {
        font-size: 20px;
        font-weight: bold;
        margin: 20px 0;
    }

    .boton-canjear {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 7px;
        background: #00b956;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

        .boton-canjear:hover {
            background: #009f4a;
        }

    @@media (max-width: 768px) {
        .recompensas {
            grid-template-columns: 1fr;
        }
    }

</style>