@page
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Inicio";

    string nombreUsuario = HttpContext.Session.GetString("NombreUsuario") ?? "Emilio Suarez";
}

<div class="home-container">

    <div class="home-content">

        <h1>Reciclaje Nacional</h1>

        <h2>Bienvenido, @nombreUsuario</h2>

        <p class="descripcion">
            Recicla tus materiales, gana puntos y obtén recompensas mientras ayudas al medio ambiente.
        </p>

        <!-- BOTONES PRINCIPALES -->

        <div class="botones-home">

            <a asp-page="/Registroreciclaje"
               class="btn-home">
                Registrar reciclaje
            </a>

            <a asp-page="/Recompensas"
               class="btn-home">
                Ver recompensas
            </a>

            <a asp-page="/Canjes"
               class="btn-home">
                Mis canjes
            </a>

        </div>

        <!-- TARJETAS -->

        <div class="tarjetas-home">

            <div class="tarjeta">

                <h3>Recicla</h3>

                <p>
                    Lleva tus materiales reciclables a nuestros centros
                    de reciclaje registrados.
                </p>

            </div>

            <div class="tarjeta">

                <h3>Gana puntos</h3>

                <p>
                    Obtén puntos dependiendo de la cantidad y tipo de
                    material que recicles.
                </p>

            </div>

            <div class="tarjeta">

                <h3>Obtén recompensas</h3>

                <p>
                    Utiliza tus puntos para canjear diferentes recompensas
                    disponibles.
                </p>

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background-color: #111111;
        color: white;
    }

    .home-container {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 55px 20px;
        background-color: #111111;
    }

    .home-content {
        width: 100%;
        max-width: 900px;
        text-align: center;
    }

        .home-content h1 {
            font-size: 44px;
            margin-bottom: 8px;
            color: white;
        }

        .home-content h2 {
            font-size: 25px;
            margin-bottom: 20px;
            color: white;
        }

    .descripcion {
        font-size: 16px;
        color: #cccccc;
        margin-bottom: 32px;
    }


    /* BOTONES */

    .botones-home {
        display: flex;
        justify-content: center;
        gap: 13px;
        margin-bottom: 48px;
    }

    .btn-home {
        display: inline-block;
        padding: 15px 25px;
        background-color: #087fdb;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        transition: background-color 0.2s;
    }

        .btn-home:hover {
            background-color: #066bb8;
            color: white;
        }


    /* TARJETAS */

    .tarjetas-home {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .tarjeta {
        background-color: #1f1f1f;
        border-radius: 10px;
        padding: 45px 25px;
        min-height: 185px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.35);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .tarjeta h3 {
            font-size: 27px;
            margin-bottom: 18px;
            color: white;
        }

        .tarjeta p {
            font-size: 15px;
            line-height: 1.7;
            color: #cccccc;
            margin: 0;
            max-width: 250px;
        }


    /* PANTALLAS PEQUEÑAS */

    @@media (max-width: 800px) {

        .tarjetas-home {
            grid-template-columns: 1fr;
        }

        .botones-home {
            flex-direction: column;
            align-items: center;
        }

        .btn-home {
            width: 220px;
        }
    }

</style>