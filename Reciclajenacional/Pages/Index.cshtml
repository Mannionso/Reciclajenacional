@page
@model ReciclajeNacional.Pages.IndexModel

@{
    ViewData["Title"] = "Inicio";
}


<div class="home-container">

    <!-- ========================================= -->
    <!-- TITULO PRINCIPAL -->
    <!-- ========================================= -->

    <div class="titulo">

        <h1>♻️ Reciclaje Nacional</h1>


        @if (!string.IsNullOrEmpty(Model.NombreUsuario))
        {
            <h2>
                Bienvenido, @Model.NombreUsuario
            </h2>
        }
        else
        {
            <h2>
                Reciclar es construir un mejor futuro
            </h2>
        }


        <p>
            Recicla tus materiales, gana puntos y obtén recompensas
            mientras ayudas al medio ambiente.
        </p>

    </div>


    <!-- ========================================= -->
    <!-- BOTONES PRINCIPALES -->
    <!-- ========================================= -->

    <div class="botones">

        <a asp-page="/Registrareciclaje"
           class="btn">

            Registrar reciclaje

        </a>


        <a asp-page="/Recompensas"
           class="btn">

            Ver recompensas

        </a>


        <a asp-page="/Canjes"
           class="btn">

            Mis canjes

        </a>

    </div>


    <!-- ========================================= -->
    <!-- TARJETAS -->
    <!-- ========================================= -->

    <div class="tarjetas">


        <!-- TARJETA RECICLA -->

        <div class="tarjeta">

            <h3>
                Recicla
            </h3>

            <p>
                Lleva tus materiales reciclables a nuestros
                centros de reciclaje registrados.
            </p>

        </div>


        <!-- TARJETA PUNTOS -->

        <div class="tarjeta">

            <h3>
                Gana puntos
            </h3>

            <p>
                Obtén puntos dependiendo de la cantidad y tipo
                de material que recicles.
            </p>

        </div>


        <!-- TARJETA RECOMPENSAS -->

        <div class="tarjeta">

            <h3>
                Obtén recompensas
            </h3>

            <p>
                Utiliza tus puntos para canjear diferentes
                recompensas disponibles.
            </p>

        </div>


    </div>

</div>


<style>

    /* ========================================= */
    /* PAGINA */
    /* ========================================= */

    body {
        background-color: #111111;
        color: white;
    }


    /* ========================================= */
    /* CONTENEDOR PRINCIPAL */
    /* ========================================= */

    .home-container {
        min-height: 75vh;
        text-align: center;
        padding: 60px 20px;
        background-color: #111111;
    }


    /* ========================================= */
    /* TITULO */
    /* ========================================= */

    .titulo h1 {
        font-size: 48px;
        margin-bottom: 10px;
        color: white;
    }


    .titulo h2 {
        font-size: 27px;
        margin-bottom: 20px;
        color: white;
    }


    .titulo p {
        font-size: 17px;
        margin-bottom: 30px;
        color: #cccccc;
    }


    /* ========================================= */
    /* BOTONES */
    /* ========================================= */

    .botones {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }


    .btn {
        background: #087fdb;
        color: white;
        padding: 14px 25px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
    }


        .btn:hover {
            background: #066bb8;
            color: white;
        }


    /* ========================================= */
    /* TARJETAS */
    /* ========================================= */

    .tarjetas {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }


    .tarjeta {
        width: 250px;
        min-height: 210px;
        padding: 30px 25px;
        background: #1f1f1f;
        color: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


        .tarjeta h3 {
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
        }


        .tarjeta p {
            font-size: 15px;
            line-height: 1.6;
            color: #cccccc;
        }

</style>